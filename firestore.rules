rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // FONCTIONS UTILITAIRES
    // ================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifie que l'uid authentifié est le prestataire du logement.
    // Accepte les deux noms de champ pour compatibilité avec les anciens docs.
    function isOwner(logementData) {
      return isAuthenticated()
        && (logementData.uid_prestataire == request.auth.uid
            || logementData.prestatireId == request.auth.uid);
    }

    // Vérifie que l'uid authentifié est participant de la conversation.
    function isParticipant(convData) {
      return isAuthenticated() && request.auth.uid in convData.participants;
    }

    // Retourne true si le document est en cours de création
    // (resource.data n'existe pas encore).
    function isCreating() {
      return !exists(request.path) || resource == null;
    }

    // Vérifie que l'utilisateur connecté a le rôle 'admin'
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.role == 'admin';
    }

    // ================================================================
    // COLLECTION : users
    // ================================================================
    match /users/{userId} {
      // Lecture publique (profils prestataires visibles de tous)
      allow read: if true;

      // Création : l'utilisateur crée son propre document
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Mise à jour :
      //  • L'admin peut tout modifier (vérifier, suspendre, activer Premium).
      //  • L'utilisateur modifie son propre document SANS changer son rôle.
      allow update: if isAdmin()
        || (
          isAuthenticated()
          && request.auth.uid == userId
          // ✅ Interdire l'auto-modification du rôle
          && request.resource.data.role == resource.data.role
        );

      // Suppression interdite côté client
      allow delete: if false;

      match /notifications/{notifId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /favoris/{favId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // ================================================================
    // COLLECTION : logements
    // ================================================================
    match /logements/{logementId} {
      // Lecture publique des annonces
      allow read: if true;

      // Création : prestataire authentifié
      allow create: if isAuthenticated();

      // Mise à jour :
      //  • Cas 1 — le propriétaire modifie son annonce, SANS pouvoir la
      //    transférer (uid_prestataire immuable après création).
      //  • Cas 2 — n'importe qui (y compris visiteur anonyme) peut incrémenter
      //    UNIQUEMENT les compteurs publics `vues` / `contacts`, sans toucher
      //    à aucun autre champ. Indispensable pour le comptage des vues côté
      //    visiteur (cf. detail_logement_screen._incrementerVues), dont
      //    dépendent les statistiques prestataire et les notifications
      //    "milestone de vues".
      allow update: if
        (
          isOwner(resource.data)
          // ✅ Interdire le changement de propriétaire
          && request.resource.data.uid_prestataire == resource.data.uid_prestataire
        )
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['vues', 'contacts'])
        // ✅ L'admin peut modérer (suspendre/réactiver) n'importe quelle annonce
        || isAdmin();

      // Suppression : propriétaire ou admin (modération)
      allow delete: if isOwner(resource.data) || isAdmin();
    }

    // ================================================================
    // COLLECTION : signalements
    // ================================================================
    match /signalements/{sigId} {

      // ── Création : ouverte à TOUS (visiteurs anonymes + prestataires) ──
      // Règle volontairement permissive pour maximiser les remontées terrain.
      // La lutte contre le spam est gérée côté app (SharedPreferences locale)
      // et côté back-office (traitement admin).
      allow create: if true;

      // ── Lecture, mise à jour, suppression : réservées aux admins ──
      // Un admin est un utilisateur authentifié dont le champ `role`
      // vaut 'admin' dans /users/{uid}. La modification du rôle étant
      // bloquée côté client (voir règle users.update), ce champ ne peut
      // être positionné que via Firebase Admin SDK (back-office sécurisé).
      allow read, update, delete: if isAdmin();
    }

    // ================================================================
    // COLLECTION : transactions (paiements GeniusPay — Premium / Sponsorisation)
    // ================================================================
    match /transactions/{txId} {
      // Lecture : le prestataire propriétaire (pour le polling du statut)
      //           ou un admin (back-office).
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isAdmin());

      // Écriture INTERDITE côté client : seules les Cloud Functions
      // (Admin SDK, qui contournent les règles) créent/mettent à jour
      // les transactions. Empêche un utilisateur de s'auto-octroyer
      // le statut Premium ou de marquer une transaction "reussi".
      allow create, update, delete: if false;
    }

    // ================================================================
    // COLLECTION : conversations
    // ================================================================
    match /conversations/{convId} {

      // Lecture : participant authentifié, visiteur anonyme, OU admin
      allow read: if
        (isAuthenticated() && request.auth.uid in resource.data.participants)
        || (!isAuthenticated())
        || isAdmin();

      // Création : tout le monde (visiteurs + prestataires)
      // SÉCURITÉ : exactement 2 participants, et le créateur (si auth) doit être dedans.
      allow create: if
        request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        // ✅ Si authentifié, le créateur doit figurer dans les participants
        && (
          !isAuthenticated()
          || request.auth.uid in request.resource.data.participants
        );

      // Mise à jour : participant auth OU visiteur anonyme
      allow update: if
        isParticipant(resource.data)
        || (!isAuthenticated());

      // Suppression : participant authentifié OU visiteur anonyme
      allow delete: if
        isParticipant(resource.data)
        || (!isAuthenticated());

      // ── messages ──────────────────────────────────────────────────
      match /messages/{msgId} {
        allow read, create, update, delete: if
          (isAuthenticated() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants)
          || (!isAuthenticated());
      }

      // ── visitor_notifications ─────────────────────────────────────
      match /visitor_notifications/{notifId} {
        allow read, create, update, delete: if
          (isAuthenticated() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants)
          || (!isAuthenticated());
      }
    }

  }
}
