rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // FONCTIONS UTILITAIRES
    // ================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifie que l'uid authentifié est le prestataire du logement.
    // Accepte les deux noms de champ pour compatibilité avec les anciens docs.
    function isOwner(logementData) {
      return isAuthenticated()
        && (logementData.uid_prestataire == request.auth.uid
            || logementData.prestatireId == request.auth.uid);
    }

    // Vérifie que l'uid authentifié est participant de la conversation.
    function isParticipant(convData) {
      return isAuthenticated() && request.auth.uid in convData.participants;
    }

    // Vérifie que l'utilisateur connecté a le rôle 'admin'
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.role == 'admin';
    }

    // ================================================================
    // COLLECTION : users
    // ================================================================
    match /users/{userId} {
      // Lecture publique (profils prestataires visibles de tous)
      allow read: if true;

      // Création : l'utilisateur crée son propre document
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Mise à jour :
      //  • L'admin peut tout modifier (vérifier, suspendre, activer Premium).
      //  • L'utilisateur modifie son propre document SANS changer son rôle.
      allow update: if isAdmin()
        || (
          isAuthenticated()
          && request.auth.uid == userId
          // ✅ Interdire l'auto-modification du rôle
          && request.resource.data.role == resource.data.role
        );

      // Suppression interdite côté client
      allow delete: if false;

      match /notifications/{notifId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /favoris/{favId} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // ================================================================
    // COLLECTION : logements
    // ================================================================
    match /logements/{logementId} {
      // Lecture publique des annonces
      allow read: if true;

      // Création : prestataire authentifié
      allow create: if isAuthenticated();

      // Mise à jour :
      //  • Cas 1 — le propriétaire modifie son annonce, SANS pouvoir la
      //    transférer (uid_prestataire immuable après création).
      //  • Cas 2 — n'importe qui (y compris visiteur anonyme) peut incrémenter
      //    UNIQUEMENT les compteurs publics `vues` / `contacts`, sans toucher
      //    à aucun autre champ.
      allow update: if
        (
          isOwner(resource.data)
          // ✅ Interdire le changement de propriétaire
          && request.resource.data.uid_prestataire == resource.data.uid_prestataire
        )
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['vues', 'contacts'])
        // ✅ L'admin peut modérer (suspendre/réactiver) n'importe quelle annonce
        || isAdmin();

      // Suppression : propriétaire ou admin (modération)
      allow delete: if isOwner(resource.data) || isAdmin();
    }

    // ================================================================
    // COLLECTION : signalements
    // ================================================================
    match /signalements/{sigId} {

      // Création : ouverte à TOUS (visiteurs anonymes + prestataires)
      allow create: if true;

      // Lecture, mise à jour, suppression : réservées aux admins
      allow read, update, delete: if isAdmin();
    }

    // ================================================================
    // COLLECTION : transactions (paiements Mobile Money — Premium / Sponsorisation)
    // ================================================================
    match /transactions/{txId} {
      // Lecture : le prestataire propriétaire (pour le polling du statut)
      //           ou un admin (back-office).
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isAdmin());

      // Écriture INTERDITE côté client : seules les Cloud Functions
      // (Admin SDK) créent/mettent à jour les transactions.
      // Empêche un utilisateur de s'auto-octroyer le statut Premium
      // ou de marquer une transaction "reussi".
      allow create, update, delete: if false;
    }

    // ================================================================
    // COLLECTION : urgences (accès prioritaire visiteur 48H)
    // ================================================================
    match /urgences/{docId} {
      // Lecture : le visiteur/prestataire consulte ses propres accès urgence.
      // L'ID du document est construit comme {uid}_{logementId}.
      allow read: if isAuthenticated()
        && (docId.matches(request.auth.uid + '_.*') || isAdmin());

      // Écriture client : utilisée en simulation (debug) et pour l'init locale.
      // En production, la Cloud Function (admin SDK) reste l'autorité.
      // Contrainte : le champ uid doit correspondre à l'uid authentifié.
      allow create, update: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;

      allow delete: if false;
    }

    // ================================================================
    // COLLECTION : paiements_web (liens de paiement email — flow iOS)
    // ================================================================
    // La page publique /pay/<token> du dashboard admin lit ce document SANS
    // authentification : l'utilisateur arrive depuis un lien reçu par email.
    // Le token (128 bits, id du document) fait office de clé porteur — qui
    // connaît l'URL peut lire, personne ne peut énumérer la collection.
    //
    // ⚠️ `allow read` couvrirait aussi `list`, ce qui exposerait toutes les
    // adresses email de la collection à n'importe qui. On n'ouvre que `get`.
    match /paiements_web/{token} {
      allow get: if true;
      allow list: if false;

      // Écriture INTERDITE côté client : seules les Cloud Functions
      // (envoyerLienPaiementEmail, initierPaiementDepuisWeb, geniuspayWebhook)
      // écrivent ici via l'Admin SDK, qui contourne ces règles.
      // Sans ce verrou, n'importe qui pourrait passer statut = "reussi".
      allow create, update, delete: if false;
    }

    // ================================================================
    // COLLECTION : admin_notifications
    // ================================================================
    match /admin_notifications/{notifId} {
      // Lecture : le prestataire concerné ou l'admin
      allow read: if isAuthenticated()
        && (resource.data.uid_prestataire == request.auth.uid || isAdmin());

      // Mise à jour : le prestataire peut uniquement marquer comme lu
      allow update: if isAuthenticated()
        && resource.data.uid_prestataire == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lu']);

      // Création/suppression : uniquement via Cloud Functions (admin SDK)
      allow create, delete: if false;
    }

    // ================================================================
    // COLLECTION : publicites (publicités prestataires)
    // ================================================================
    match /publicites/{pubId} {
      // Lecture publique : affichage stories overlay + dashboard prestataire
      allow read: if true;

      // Création : prestataire connecté (brouillon initial avant paiement)
      allow create: if isAuthenticated();

      // Mise à jour : prestataire propriétaire uniquement
      // (activation via webhook Cloud Function utilise admin SDK, bypass rules)
      allow update: if isAuthenticated()
        && resource.data.prestataireId == request.auth.uid;

      // Suppression : propriétaire ou admin
      allow delete: if isAuthenticated()
        && (resource.data.prestataireId == request.auth.uid || isAdmin());
    }

    // ================================================================
    // COLLECTION : conversations
    // ================================================================
    match /conversations/{convId} {

      // Lecture : participant authentifié, visiteur anonyme, OU admin
      allow read: if
        (isAuthenticated() && request.auth.uid in resource.data.participants)
        || (!isAuthenticated())
        || isAdmin();

      // Création : tout le monde (visiteurs + prestataires)
      // SÉCURITÉ : exactement 2 participants, et le créateur (si auth) doit être dedans.
      allow create: if
        request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && (
          !isAuthenticated()
          || request.auth.uid in request.resource.data.participants
        );

      // Mise à jour : participant auth OU visiteur anonyme
      allow update: if
        isParticipant(resource.data)
        || (!isAuthenticated());

      // Suppression : participant authentifié OU visiteur anonyme
      allow delete: if
        isParticipant(resource.data)
        || (!isAuthenticated());

      // ── messages ──────────────────────────────────────────────────
      // Couvre tous les types : text, image, video, file, + champ replyTo optionnel.
      match /messages/{msgId} {
        // Lecture : participant, visiteur anonyme (chat visiteur), OU admin (modération).
        allow read: if
          (isAuthenticated() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants)
          || (!isAuthenticated())
          || isAdmin();
        // Écriture : participant ou visiteur anonyme (admin ne poste pas depuis le web).
        allow create, update, delete: if
          (isAuthenticated() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants)
          || (!isAuthenticated());
      }

      // ── visitor_notifications ─────────────────────────────────────
      match /visitor_notifications/{notifId} {
        allow read, create, update, delete: if
          (isAuthenticated() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(convId)).data.participants)
          || (!isAuthenticated());
      }
    }

    // ================================================================
    // AUTHENTIFICATION OTP — collections 100 % serveur
    // ================================================================
    // Ces quatre collections sont écrites et lues EXCLUSIVEMENT par les Cloud
    // Functions de functions/otp.js via l'Admin SDK, qui contourne ces règles.
    // Rien ici n'est accessible depuis un client, et c'est indispensable :
    //
    //   • otp_sessions   — un `read` exposerait le sel de chaque session ;
    //                      combiné à une fuite du poivre, il rendrait les
    //                      hashes de codes cassables par force brute (10⁶).
    //                      Un `write` permettrait de repasser `consomme` à
    //                      false ou de remettre `tentatives` à zéro, ce qui
    //                      annulerait toute la protection anti-force-brute.
    //   • refresh_tokens — un `read` livrerait les hashes de session de tous
    //                      les utilisateurs ; un `write` permettrait de
    //                      dé-révoquer un jeton volé.
    //   • trusted_devices — un `write` suffirait à s'inscrire comme appareil
    //                      de confiance du numéro d'autrui et à recevoir ses
    //                      codes par push silencieux.
    //   • otp_rate_limits / otp_deliveries — un `write` remettrait les
    //                      compteurs anti-abus à zéro.
    //
    // Le back-office consulte les statistiques via la Cloud Function
    // authOtpStatistiques (contrôle du rôle admin côté serveur), pas en
    // lecture directe.
    match /otp_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Index inversé numéro → session pour le callback vocal Africa's Talking.
    // Un `write` permettrait de rediriger l'appel vocal d'un numéro vers sa
    // propre session, et donc de se faire dicter un code au nom d'autrui.
    match /otp_voice_pending/{telephone} {
      allow read, write: if false;
    }

    match /otp_rate_limits/{limiteId} {
      allow read, write: if false;
    }

    match /otp_deliveries/{livraisonId} {
      allow read, write: if false;
    }

    match /refresh_tokens/{jti} {
      allow read, write: if false;
    }

    match /trusted_devices/{appareilId} {
      allow read, write: if false;
    }

  }
}