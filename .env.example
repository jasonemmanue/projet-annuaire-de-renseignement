# ─── horem-api — variables (Railway → service horem-api → Variables) ───────
# [requis]
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
ENVIRONMENT=production
PUBLIC_BASE_URL=https://horem-api-production.up.railway.app
WEB_CONCURRENCY=2
CORS_ORIGINS=*

# Firebase : compte de service (JSON encodé en base64, une ligne).
# Sert à : notifications push, création de comptes offerts, suppression des
# fichiers Storage, reprise des données Firestore.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=sgk-home
FIREBASE_STORAGE_BUCKET=sgk-home.firebasestorage.app

# Administrateurs (e-mails séparés par des virgules) : rôle admin à la connexion.
ADMIN_EMAILS=
# Alertes « nouvelle publication » (vide = aucun e-mail).
ADMIN_NOTIF_EMAIL=

# GeniusPay — webhook à déclarer dans le portail :
#   https://horem-api-production.up.railway.app/api/v1/paiements/webhook
GENIUSPAY_API_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_WEBHOOK_SECRET=
# true = paiements simulés (réussis après ~4 s). JAMAIS en production.
PAIEMENTS_SIMULES=false

# Page de paiement iOS (admin)
WEB_PAY_BASE_URL=https://horem-a-admin-production.up.railway.app/pay

# E-mails (Railway bloque le SMTP) : Gmail API, sinon Resend
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_SENDER=
RESEND_API_KEY=
